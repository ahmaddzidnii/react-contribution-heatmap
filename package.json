{
  "name": "react-contribution-heatmap",
  "version": "2.0.0",
  "description": "Lightweight, customizable GitHub-style contribution and activity heatmap component for React.",
  "license": "MIT",
  "author": "ahmaddzidnii",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "dev": "npm --workspace=examples/basic run dev",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npx biome check --write . && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "release:patch": "npm run check && npm version patch -m \"chore(release): v%s\" && git push origin main --follow-tags",
    "release:minor": "npm run check && npm version minor -m \"chore(release): v%s\" && git push origin main --follow-tags",
    "release:major": "npm run check && npm version major -m \"chore(release): v%s\" && git push origin main --follow-tags"
  },
  "keywords": [
    "react",
    "heatmap",
    "contribution-heatmap",
    "contribution-graph",
    "github-heatmap",
    "calendar-heatmap",
    "activity-heatmap",
    "activity-calendar",
    "habit-tracker",
    "streak"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmaddzidnii/react-contribution-heatmap.git"
  },
  "homepage": "https://react-contribution-heatmap.ahmadzidni.com",
  "bugs": {
    "url": "https://github.com/ahmaddzidnii/react-contribution-heatmap/issues"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
